OPENAI_API_KEY=your_openai_api_key_here
EXCHANGE_CACHE_PATH=./exchange_cache
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
OPENAI_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=medium
# Legacy fallback for either RAG count when its RAG_* setting is omitted.
TOP_K=4
RAG_RETRIEVAL_K=20
RAG_FINAL_K=4
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v5.0-fast
# Recursive splitter target size and repeated context, in characters.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150